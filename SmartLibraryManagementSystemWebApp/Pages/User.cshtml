@page "{id}"
@model UserModel
@{
    if (Model.IsFaculty)
    {
        ViewData["Title"] = Model.User.Faculty.FacultyName;
    }
    else
    {
        ViewData["Title"] = Model.User.Student.StudentName;
    }
}
<form id="userInfo" asp-page="UpdateUser" method="post" data-is-faculty="@Model.IsFaculty">
    @if (Model.IsFaculty)
    {
        <div>
            <p id="editName">@Model.User.Faculty.FacultyName</p>
        </div>
        <div>
            <p id="editCourse">@Model.User.Faculty.Course</p>
        </div>
        <div>
            <p id="editDepartment">@Model.User.Faculty.Department</p>
        </div>
        <div>
            <p id="editEmail">@Model.User.Faculty.Email</p>
        </div>
        <div>
            <label>Password:</label>
            <input disabled id="editPassword" type="password"/>
        </div>
        <div>
            <p id="editSubject">@Model.User.Faculty.Subject</p>
        </div>
    }
    else
    {
        <div>
            <p id="editName">@Model.User.Student.StudentName</p>
        </div>
        <div>
            <p id="editCourse">@Model.User.Student.Course</p>
        </div>
        <div>
            <p id="editDepartment">@Model.User.Student.Department</p>
        </div>
        <div>
            <p id="editEmail">@Model.User.Student.Email</p>
        </div>
        <div>
            <label>Password:</label>
            <input disabled id="editPassword" type="password"/>
        </div>
        <div>
            <p id="editGrade">@Model.User.Student.Grade</p>
        </div>
    }
    <button id="edit">Edit</button>
    <button id="cancelEdit">Cancel</button>
    <button id="submitEdit" type="submit">Submit</button>
</form>
<h1>Fines</h1>
<ul>
    @foreach (var fine in Model.User.Fines)
    {
        <li>
            <p style="font-weight: bold;">@fine.FineAmount</p>
        </li>
    }
</ul>
<h1>Loans</h1>
<ul>
    @foreach (var loan in Model.User.Loans)
    {
        <li>
            <p style="font-weight: bold;">@loan.LoanAmount</p>
        </li>
    }
</ul>
<h1>Reservations</h1>
<ul>
    @foreach (var reservation in Model.User.Reservations)
    {
        <li>
            @reservation.Book.BookName @reservation.Catalog.ClassificationId @reservation.Catalog.Genre
            @reservation.Fine.FineAmount
            @reservation.Loan.LoanAmount
            @reservation.ReservationDateTime
        </li>
    }
</ul>
<form method="post" asp-page="UpdateUser">
    <button type="submit">Delete</button>
</form>

@section Scripts {
    <script src="~/js/User.js"></script>
}