@page "{id}"
@model BookModel
@{
    ViewData["Title"] = @Model.Book.BookName;
}

@section Stylesheets {
    <link rel="stylesheet" href="~/css/Book.css"/>
}

<form id="bookInfo" asp-page="UpdateBook" enctype="multipart/form-data">
    <div id="bookInfoField">
        <div>
            <h1 id="bookName">@Model.Book.BookName</h1>
        </div>
        <div>
            <h2 id="bookAuthor">@Model.Book.Author</h2>
        </div>
        <div>
            <h3 id="bookReleaseDate">@Model.Book.ReleaseDate</h3>
        </div>
        <div>
            <p id="bookSynopsis">@Model.Book.Synopsis</p>
        </div>
        <div>
            <p id="bookClassificationId">@Model.Book.Catalog.ClassificationId</p>
        </div>
        <div>
            <p id="bookCopies">@Model.Book.Catalog.Copies</p>
        </div>
        <div>
            <p id="bookGenre">@Model.Book.Catalog.Genre</p>
        </div>
    </div>
    <div id="bookImgContainer">
        <div>
            <img id="bookImg" src="@Model.Book.BookImgPath"/>
        </div>
        <div id="bookImgActxBtns">
            @if (Model.IsAdmin)
            {
                <button id="edit">edit</button>
                <button id="cancelEdit">cancel</button>
                <button id="submitEdit">submit</button>
                @if (Model.HasFine)
                {
                    <button form="loanForm" id="loan">Loan</button>
                }
                else
                {
                    <button form="loanForm" id="borrow">Borrow</button>
                }
            }
        </div>
    </div>
</form>
<form id="loanForm" method="post">
</form>

@section Scripts {
    <script src="~/js/Book.js"></script>
}