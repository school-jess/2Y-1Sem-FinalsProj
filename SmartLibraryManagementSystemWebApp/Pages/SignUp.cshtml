@page
@model SignUpModel

@{
    ViewData["Title"] = "Sign Up Page";
}

<form method="post">
    <div>
        <label asp-for="Input.Name">Name: </label>
        <input asp-for="Input.Name" />
        <span asp-validation-for="Input.Name"></span>
    </div>
    <div>
        <label asp-for="Input.Department">Department: </label>
        <input asp-for="Input.Department" />
        <span asp-validation-for="Input.Department"></span>
    </div>
    <div>
        <label asp-for="Input.Course">Course: </label>
        <input asp-for="Input.Course" />
        <span asp-validation-for="Input.Course"></span>
    </div>
    <div>
        <label asp-for="Input.Email">Email: </label>
        <input asp-for="Input.Email" />
        <span asp-validation-for="Input.Email"></span>
    </div>
    <div>
        <label asp-for="Input.Password">Password: </label>
        <input asp-for="Input.Password" />
        <span asp-validation-for="Input.Password"></span>
    </div>
    <div>
        <label asp-for="Input.ConfirmPassword">Confirm Password: </label>
        <input type="password" asp-for="Input.ConfirmPassword" />
        <span asp-validation-for="Input.ConfirmPassword"></span>
    </div>
    <div id="subject">
        <label asp-for="Input.Subject">Subject: </label>
        <input asp-for="Input.Subject" />
        <span asp-validation-for="Input.Subject"></span>
    </div>
    <div id="grade">
        <label asp-for="Input.Grade">Grade: </label>
        <input asp-for="Input.Grade" />
        <span asp-validation-for="Input.Grade"></span>
    </div>
    <div>
        <input type="checkbox" asp-for="Input.IsEducator" id="IsEducator" />
        <label asp-for="Input.IsEducator">Is educator</label>
        <span asp-validation-for="Input.IsEducator"></span>
    </div>
    <button type="submit">Submit</button>
</form>

@section Scripts {
    <script src="~/js/SignUp.js"></script>
}