@page
@model AdminModel
@{
}

<div id="grid">
    <div>
        Username
    </div>
    <div>
        Has fine
    </div>
    <div>
        Has loan
    </div>
    <div>
        Is admin
    </div>
    <div></div>
    @foreach (var user in Model.Users)
    {
        <div>
            @user.UserName
        </div>
        <div>
            @if (user.HasFine)
            {
                <input type="checkbox" checked/>
            }
            else
            {
                <input type="checkbox"/>
            }
        </div>
        <div>
            @if (user.HasLoan)
            {
                <input type="checkbox" checked/>
            }
            else
            {
                <input type="checkbox"/>
            }
        </div>
        <div>
            @if (user.IsAdmin)
            {
                <input type="checkbox" checked/>
            }
            else
            {
                <input type="checkbox"/>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/Admin.js"></script>
}