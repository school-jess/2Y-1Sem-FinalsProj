@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
</head>

<body>
    @{
        string isLoggedIn = Context.Session.GetString("IsLoggedIn");
        string logInName = Context.Session.GetString("LogInName");
        string userId = Context.Session.GetString("UserId");
    }
    <input placeholder="Search a book..." />
    @if (isLoggedIn == "true")
    {
        <a asp-page="/User/@userId">@logInName</a>
        <a asp-page="/LogOut">Log Out</a>
    }
    else
    {
        <a asp-page="/LogIn">Log In</a>
        <a asp-page="/SignUp">Sign In</a>
    }
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>