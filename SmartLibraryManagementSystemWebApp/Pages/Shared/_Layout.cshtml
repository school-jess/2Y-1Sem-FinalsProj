@inject HttpContext HttpContext
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
</head>

<body>
    <input placeholder="Search a book..."/>
    @if (HttpContext.Session.GetString("IsLoggedIn") == "true")
    {
        <a asp-page='/User/@HttpContext.Session.GetString("UserId")'>@HttpContext.Session.GetString("LogInName")</a>
        <a>Log Out(todo)</a>
    }
    else
    {
        <a asp-page="/LogIn">Log In</a>
    }
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>