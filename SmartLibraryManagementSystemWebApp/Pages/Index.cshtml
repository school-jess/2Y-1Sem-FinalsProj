@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    string currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}

@section ExtraNavElems {
    <input id="searchBar" placeholder="Search a book..."/>
    @if (Model.IsAdmin)
    {
        <a class="@(currentPage == "/LogIn" ? "active" : "")" asp-page="/NewBook">New Book</a>
    }
}
<ol>
    @foreach (var book in Model.Books)
    {
        <li>
            <img src="@book.BookImgPath"/>
            <a asp-page="/Book" asp-route-id="@book.BookId">@book.BookName - @book.Author</a>
            <form method="post">
                <input type="hidden" asp-for="Input.BookId" value="@book.BookId"/>
                <button>Delete</button>
            </form>
        </li>
    }
</ol>

@section Scripts {
    <script src="~/js/Index.js"></script>
}