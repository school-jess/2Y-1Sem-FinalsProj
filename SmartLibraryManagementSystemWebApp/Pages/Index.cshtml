@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (Model.IsAdmin) {
    <a asp-page="/NewBook">New Book</a>
}
<ol>
    @foreach (var book in Model.Books)
    {
        <li>
            <span>@book.BookName - @book.Author</span>
            @if (Model.IsAdmin) {
                <button id="edit-book@book.BookId"><img src="~/pen.png" /></button>
                <button><img id="delete-book@book.BookId" src="~/recycle-bin.png" /></button>
            }
        </li>
    }
</ol>