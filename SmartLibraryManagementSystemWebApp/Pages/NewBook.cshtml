@page
@model NewBookModel
@{
}
<form method="post">
    <div>
        <label asp-for="Input.Name">Book Name: </label>
        <input asp-for="Input.Name"/>
        <span asp-validation-for="Input.Name"></span>
    </div>
    <div>
        <label asp-for="Input.Author">Author: </label>
        <input asp-for="Input.Author"/>
        <span asp-validation-for="Input.Author"></span>
    </div>
    <div>
        <label asp-for="Input.ReleaseDate">Release Date: </label>
        <input type="date" asp-for="Input.ReleaseDate"/>
        <span asp-validation-for="Input.ReleaseDate"></span>
    </div>
    <div>
        <label asp-for="Input.Synopsis">Synopsis: </label>
        <input asp-for="Input.Synopsis"/>
        <span asp-validation-for="Input.Synopsis"></span>
    </div>
    <div>
        <label asp-for="Input.ClassificationId">Classification ID: </label>
        <input asp-for="Input.ClassificationId"/>
        <span asp-validation-for="Input.ClassificationId"></span>
    </div>
    <div>
        <label asp-for="Input.Copies">Copies: </label>
        <input asp-for="Input.Copies"/>
        <span asp-validation-for="Input.Copies"></span>
    </div>
    <div>
        <label asp-for="Input.Genre">Genre: </label>
        <input asp-for="Input.Genre"/>
        <span asp-validation-for="Input.Genre"></span>
    </div>
    <button type="submit">Submit</button>
</form>
